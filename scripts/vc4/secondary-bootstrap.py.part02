chState *envp, CPUVC4State *env, unsigned reg)
{
    uint32_t sp = env->gpr[VC4_REG_SP] - 4;

    env->gpr[VC4_REG_SP] = sp;
    cpu_stl_le_data(envp, sp, vc4_env_get_reg(env, reg));
}

static void vc4_pop(CPUArchState *envp, CPUVC4State *env, unsigned reg)
{
    uint32_t sp = env->gpr[VC4_REG_SP];
    uint32_t value = cpu_ldl_le_data(envp, sp);

    vc4_env_set_reg(env, reg, value);
    env->gpr[VC4_REG_SP] = sp + 4;
}

void helper_vc4_push_pop(CPUArchState *envp, uint32_t push, uint32_t lrpc,
                         uint32_t start, uint32_t count)
{
    CPUVC4State *env = vc4_helper_env(envp);
    int i;

    if (push) {
        if (lrpc) {
            vc4_push(envp, env, VC4_REG_LR);
        }
        if (lrpc && (((count - 1) & 0xf) == 0xf)) {
            if ((count - 1) == 0x1f) {
                vc4_push(envp, env, start);
            }
        } else {
            for (i = 0; i < count; i++) {
                vc4_push(envp, env, (start + i) % VC4_NUM_REGS);
            }
        }
    } else {
        if (lrpc && (((count - 1) & 0xf) == 0xf)) {
            if ((count - 1) == 0x1f) {
                vc4_pop(envp, env, start);
            }
        } else {
            for (i = count - 1; i >= 0; i--) {
                vc4_pop(envp, env, (start + i) % VC4_NUM_REGS);
            }
        }
        if (lrpc) {
            vc4_pop(envp, env, VC4_REG_PC);
        }
    }
}

void helper_vc4_rti(CPUArchState *envp)
{
    CPUVC4State *env = vc4_helper_env(envp);
    VC4CPU *cpu = vc4_env_archcpu(env);
    uint32_t sp = env->gpr[VC4_REG_SP];

    env->sr = cpu_ldl_le_data(envp, sp);
    env->pc = cpu_ldl_le_data(envp, sp + 4);
    env->gpr[VC4_REG_SP] = sp + 8;

    if (env->exception_depth) {
        env->exception_depth--;
        if (env->exception_depth == 0) {
            env->gpr[28] = env->gpr[VC4_REG_SP];
            env->gpr[VC4_REG_SP] = env->normal_sp;
        }
    }

    if (cpu->intc) {
        bcm2835_vc4_intc_complete(cpu->intc);
    }
}

G_NORETURN void helper_vc4_raise_illegal(CPUArchState *envp, uint32_t pc,
                                         uint32_t opcode)
{
    CPUVC4State *env = vc4_helper_env(envp);
    CPUState *cs = env_cpu(envp);

    env->pc = pc;
    cs->exception_index = VC4_EXCP_ILLEGAL;
    qemu_log_mask(LOG_UNIMP,
                  "VideoCore IV: unimplemented opcode 0x%04x at 0x%08x\n",
                  opcode & 0xffff, pc);
    cpu_loop_exit(cs);
}

G_NORETURN void helper_vc4_halt(CPUArchState *envp)
{
    CPUVC4State *env = vc4_helper_env(envp);
    CPUState *cs = env_cpu(envp);

    qemu_log_mask(CPU_LOG_EXEC, "VideoCore IV: HALT at 0x%08x\n", env->pc);
    cs->halted = 1;
    cpu_loop_exit(cs);
}
''',
)

# Make helper expansion explicit so an AArch64 build does not accidentally
# include target/arm/helper.h while compiling the embedded VC4 translator.
replace(
    "target/vc4/translate.c",
    """#include "exec/helper-proto.h"
#include "exec/helper-gen.h"
""",
    """#include "exec/helper-proto-common.h"
#define HELPER_H "target/vc4/helper.h"
#include "exec/helper-proto.h.inc"
#undef HELPER_H
#include "exec/helper-gen-common.h"
#define HELPER_H "target/vc4/helper.h"
#include "exec/helper-gen.h.inc"
#undef HELPER_H
""",
)
replace(
    "target/vc4/translate.c",
    '#define HELPER_H "helper.h"\n#include "exec/helper-info.c.inc"',
    '#define HELPER_H "target/vc4/helper.h"\n#include "exec/helper-info.c.inc"',
)
replace(
    "target/vc4/translate.c",
    "return translator_lduw_end(ctx->env, &ctx->base, addr, MO_LE);",
    "return translator_lduw_end((CPUArchState *)(void *)ctx->env,\n"
    "                               &ctx->base, addr, MO_LE);",
)
replace(
    "target/vc4/translate.c",
    "    ctx->env = cpu_env(cs);",
    "    ctx->env = vc4_cpu_env(cs);",
)

# Rename all helper generator calls before inserting the address-width wrappers.
for old, new in (
    ("gen_helper_complex_alu", "gen_helper_vc4_complex_alu"),
    ("gen_helper_div", "gen_helper_vc4_div"),
    ("gen_helper_mulhd", "gen_helper_vc4_mulhd"),
    ("gen_helper_push_pop", "gen_helper_vc4_push_pop"),
    ("gen_helper_rti", "gen_helper_vc4_rti"),
    ("gen_helper_raise_illegal", "gen_helper_vc4_raise_illegal"),
    ("gen_helper_halt", "gen_helper_vc4_halt"),
):
    replace_all("target/vc4/translate.c", old, new)

# QEMU memory operations use the primary target's address TCG type.  Extend
# the VPU's 32-bit address when embedded in a 64-bit AArch64 executable.
replace_all("target/vc4/translate.c", "tcg_gen_qemu_st_i32(",
            "vc4_gen_qemu_st_i32(")
replace_all("target/vc4/translate.c", "tcg_gen_qemu_ld_i32(",
            "vc4_gen_qemu_ld_i32(")
replace(
    "target/vc4/translate.c",
    """static void vc4_gen_load_store_addr(DisasContext *ctx, unsigned cond,
                                    bool store, unsigned format, unsigned rd,
                                    TCGv_i32 address)
""",
    """static void vc4_gen_qemu_st_i32(TCGv_i32 value, TCGv_i32 address,
                                  TCGArg mmu_idx, MemOp memop)
{
#if TARGET_LONG_BITS == 64
    TCGv_i64 wide = tcg_temp_new_i64();

    tcg_gen_extu_i32_i64(wide, address);
    tcg_gen_qemu_st_i32(value, wide, mmu_idx, memop);
#else
    tcg_gen_qemu_st_i32(value, address, mmu_idx, memop);
#endif
}

static void vc4_gen_qemu_ld_i32(TCGv_i32 value, TCGv_i32 address,
                                  TCGArg mmu_idx, MemOp memop)
{
#if TARGET_LONG_BITS == 64
    TCGv_i64 wide = tcg_temp_new_i64();

    tcg_gen_extu_i32_i64(wide, address);
    tcg_gen_qemu_ld_i32(value, wide, mmu_idx, memop);
#else
    tcg_gen_qemu_ld_i32(value, address, mmu_idx, memop);
#endif
}

static void vc4_gen_load_store_addr(DisasContext *ctx, unsigned cond,
                                    bool store, unsigned format, unsigned rd,
                                    TCGv_i32 address)
""",
)

# The global replacement touched the wrappers we just inserted only if it ran
# afterwards; it deliberately ran before insertion, so their calls stay native.

# Secondary frontend wrapper translation units.  Including target/arm/cpu.h
# first supplies the primary CPUArchState type used by generic TCG APIs.
for name in ("cpu", "gdbstub", "op_helper", "translate"):
    write(
        f"target/arm/vc4-secondary/{name}.c",
        f'''\
#define VC4_SECONDARY_FRONTEND 1
#include "target/arm/cpu.h"
#include "../../vc4/{name}.c"
''',
    )

replace(
    "target/arm/meson.build",
    """arm_common_system_ss.add(files(
  'arch_dump.c',
""",
    """arm_common_system_ss.add(when: 'CONFIG_VC4_HETERO_SMOKE', if_true: files(
  'vc4-secondary/cpu.c',
  'vc4-secondary/gdbstub.c',
  'vc4-secondary/op_helper.c',
  'vc4-secondary/translate.c',
))

arm_common_system_ss.add(files(
  'arch_dump.c',
""",
)

# ---------------------------------------------------------------------------
# A minimal two-ISA machine that exercises identical physical PC/TB keys.
# ---------------------------------------------------------------------------
write(
    "hw/arm/vc4_hetero.c",
    r'''
/*
 * AArch64 + VideoCore IV heterogeneous TCG smoke machine
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */

#include "qemu/osdep.h"
#include "qapi/error.h"
#include "qemu/units.h"
#include "hw/core/boards.h"
#include "hw/core/loader.h"
#include "system/memory.h"
#include "target/arm/cpu.h"
#define VC4_SECONDARY_FRONTEND 1
#include "target/vc4/cpu-qom.h"
#undef VC4_SECONDARY_FRONTEND

#define TYPE_VC4_HETERO_MACHINE MACHINE_TYPE_NAME("vc4-hetero-smoke")
OBJECT_DECLARE_SIMPLE_TYPE(VC4HeteroMachineState, VC4_HETERO_MACHINE)

struct VC4HeteroMachineState {
    MachineState parent_obj;
};

static void vc4_hetero_set_pc(CPUState *cs, vaddr pc)
{
    CPUClass *cc = CPU_GET_CLASS(cs);

    g_assert(cc->set_pc);
    cc->set_pc(cs, pc);
}

static void vc4_hetero_init(MachineState *machine)
{
    static const uint8_t polyglot[] = {
        0x00, 0x00, 0x00, 0x14, /* AArch64: b . ; VC4: halt */
    };
    MemoryRegion *sysmem = get_system_memory();
    CPUState *arm;