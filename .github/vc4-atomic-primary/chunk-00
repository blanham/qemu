             git pull --rebase origin "$BRANCH"
             git push origin HEAD:"$BRANCH"
           fi
 
-      - name: Require the current explicit handoff/modeset proof
+      - name: Require explicit handoff and atomic primary-plane proof
         if: always()
         run: |
