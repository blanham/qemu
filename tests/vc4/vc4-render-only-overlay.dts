/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2835";

    /*
     * Enable the DRM master, V3D, and HVS.  The VC4 DRM master allocates
     * planes from HVS state even when the test only intends to exercise the
     * render node, so a V3D-only component set is not a valid Linux VC4
     * topology and crashes in vc4_plane_create_additional_planes().
     *
     * Keep pixel valves, HDMI, VEC, TXP, and firmware-KMS nodes in their
     * base-DTB state.  This remains the smallest useful render-oriented
     * topology while matching the driver's real component assumptions.
     */
    fragment@0 {
        target = <&v3d>;
        __overlay__ {
            status = "okay";
        };
    };

    fragment@1 {
        target = <&hvs>;
        __overlay__ {
            status = "okay";
        };
    };

    fragment@2 {
        target = <&vc4>;
        __overlay__ {
            status = "okay";
        };
    };
};
